rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================
       Helpers (null-safe)
    ============================ */
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    // Firebase anonymous auth?
    function isAnonAuth() {
      return signedIn()
        && ("firebase" in request.auth.token)
        && ("sign_in_provider" in request.auth.token.firebase)
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    // --- Null-safe user lookup ---
    function myUserPath() {
      return /databases/$(database)/documents/users/$(myUid());
    }

    function myUserExists() {
      return signedIn() && exists(myUserPath());
    }

    // Returnerer {} hvis user-doc ikke finnes (så rules ikke krasjer)
    function myUser() {
      return myUserExists() ? get(myUserPath()).data : {};
    }

    function isMap(x) {
      return x is map;
    }

    // true bare hvis m er map, key finnes, og verdien er true
    function mapHasTrue(m, key) {
      return isMap(m) && (key in m) && m[key] == true;
    }

    function hasRole(roleName) {
      return mapHasTrue(myUser().roles, roleName);
    }

    function isAdmin() {
      return signedIn() && hasRole("admin");
    }

    /* ============================
       Space membership helpers
       spaceMembers/{spaceId_uid}
    ============================ */
    function memberDocId(spaceId, uid) {
      return spaceId + "_" + uid;
    }

    function myMemberPath(spaceId) {
      return /databases/$(database)/documents/spaceMembers/$(memberDocId(spaceId, myUid()));
    }

    function isSpaceMember(spaceId) {
      return signedIn() && exists(myMemberPath(spaceId));
    }

    function spacePath(spaceId) {
      return /databases/$(database)/documents/spaces/$(spaceId);
    }

    function spaceExists(spaceId) {
      return exists(spacePath(spaceId));
    }

    function isSpaceOwner(spaceId) {
      return signedIn()
        && spaceExists(spaceId)
        && get(spacePath(spaceId)).data.ownerId == myUid();
    }

    function spaceIsOpen(spaceId) {
      return spaceExists(spaceId) && get(spacePath(spaceId)).data.isOpen == true;
    }

    /* ============================
       Attestering + mode helpers
       - B1: Space-sharing krever attestering
    ============================ */
    function hasAttested() {
      // attestation.acceptedAt finnes
      return signedIn()
        && ("attestation" in myUser())
        && isMap(myUser().attestation)
        && ("acceptedAt" in myUser().attestation);
    }

    function myMode() {
      return ("mode" in myUser()) ? myUser().mode : "student";
    }

    function isTeacherMode() {
      return signedIn() && (myMode() == "teacher");
    }

    function isCreatorMode() {
      return signedIn() && (myMode() == "creator");
    }

    /* ============================
       USERS
       /users/{uid}
    ============================ */
    match /users/{uid} {

      function isSelf() {
        return signedIn() && myUid() == uid;
      }

      // changedKeys() kan bare brukes på update (resource finnes da)
      function changedKeys() {
        return request.resource.data.diff(resource.data).changedKeys();
      }

      function isChanging(field) {
        return changedKeys().hasAny([field]);
      }

      // Self-update: ikke tillat endring av roles
      function rolesNotChangedBySelf() {
        return !isChanging("roles");
      }

      // Self-update: tillat endring av mode
      function modeOk() {
        return !isChanging("mode")
          || (request.resource.data.mode is string);
      }

      function currentTeacherStatus() {
        return ("teacherStatus" in resource.data) ? resource.data.teacherStatus : "none";
      }

      function teacherStatusSelfOk() {
        return !isChanging("teacherStatus")
          || (
            request.resource.data.teacherStatus == "pending"
            && (currentTeacherStatus() == "none" || currentTeacherStatus() == "rejected")
          );
      }

      allow create: if isSelf();
      allow read: if isSelf() || isAdmin();

      allow update: if isAdmin()
        || (isSelf() && rolesNotChangedBySelf() && teacherStatusSelfOk() && modeOk());

      allow delete: if false;
    }

    /* ============================
       SPACE MEMBERS
       /spaceMembers/{docId}
       docId = "{spaceId}_{uid}"
       - Self can create/update/read own membership (works for anon too)
       - Space owner/admin can read membership docs for their space
    ============================ */
    match /spaceMembers/{docId} {

      function resSpaceId() {
        return (resource != null && ("spaceId" in resource.data)) ? resource.data.spaceId : null;
      }

      // ✅ 1) Null-safe reqSpaceId()
      function reqSpaceId() {
        return (request.resource != null
          && request.resource.data is map
          && ("spaceId" in request.resource.data))
          ? request.resource.data.spaceId
          : null;
      }

      function resUid() {
        return (resource != null && ("uid" in resource.data)) ? resource.data.uid : null;
      }

      // ✅ 1) Null-safe reqUid()
      function reqUid() {
        return (request.resource != null
          && request.resource.data is map
          && ("uid" in request.resource.data))
          ? request.resource.data.uid
          : null;
      }

      // ✅ 3) Read-safe selfDoc()
      function selfDoc() {
        return signedIn() && (
          (resource != null && resUid() == myUid())
          || (reqUid() != null && reqUid() == myUid())
        );
      }

      // ✅ 2) Read-safe ownerOfThisMemberDoc()
      function ownerOfThisMemberDoc() {
        // På read/get av doc som ikke finnes: resource == null, og request.resource finnes ikke.
        // Derfor må owner-check kun gjøres når docen finnes.
        return signedIn()
          && resource != null
          && ("spaceId" in resource.data)
          && (resource.data.spaceId is string)
          && isSpaceOwner(resource.data.spaceId);
      }

      // Create/update by self: allow merge fields (archived, role, etc.) but must keep uid==myUid and correct docId
      allow create: if signedIn()
        && (request.resource.data.uid is string)
        && (request.resource.data.spaceId is string)
        && request.resource.data.uid == myUid()
        && docId == (request.resource.data.spaceId + "_" + myUid());

      allow update: if signedIn()
        && resource != null
        && (resource.data.uid is string)
        && (resource.data.spaceId is string)
        && resource.data.uid == myUid()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.spaceId == resource.data.spaceId
        && docId == (resource.data.spaceId + "_" + myUid());

      // Read: self OR space owner OR admin
      allow read: if isAdmin() || selfDoc() || ownerOfThisMemberDoc();
      allow delete: if false;
    }

    /* ============================
       LESSONS
       /lessons/{lessonId}
       - Owner/admin full
       - MVP: students (signed in incl anon) can read IF published/active
         (Adjust these fields to your real lesson schema)
    ============================ */
    match /lessons/{lessonId} {

      function isOwner() {
        return signedIn() && resource != null && resource.data.ownerId == myUid();
      }

      function isPublishedForStudents() {
        // ✅ MVP rule: allow if lesson is marked published/active.
        // Adjust if your schema differs.
        return resource != null && (
          (("status" in resource.data) && (resource.data.status == "published" || resource.data.status == "unlisted"))
          || (("isActive" in resource.data) && resource.data.isActive == true)
        );
      }

      allow read: if isAdmin() || isOwner() || (signedIn() && isPublishedForStudents());

      allow create: if signedIn()
        && request.resource.data.ownerId == myUid();

      allow update: if isAdmin() || isOwner();

      allow delete: if isAdmin();
    }

    /* ============================
       PUBLISHED LESSONS
       /published_lessons/{id}
    ============================ */
    match /published_lessons/{id} {
      allow read: if (resource != null && resource.data.isActive == true) || isAdmin();
      allow write: if false;
    }

    /* ============================
       SPACES
       /spaces/{spaceId}
       - Public read OK for MVP (join pages etc.)
       - Owner/admin can update
       - Create requires attest + teacher/creator (or admin)
    ============================ */
    match /spaces/{spaceId} {

      // ✅ Keep metadata public (join + landing). If you want to hide later:
      // allow read: if isSpaceMember(spaceId) || isAdmin() || isSpaceOwner(spaceId);
      allow read: if true;

      allow create: if (
          isAdmin()
          || (
            signedIn()
            && hasAttested()
            && (isTeacherMode() || isCreatorMode())
          )
        )
        && request.resource.data.ownerId == myUid()
        && request.resource.data.title is string
        && request.resource.data.code is string
        && request.resource.data.isOpen is bool;

      // ✅ Owner/admin can edit space, including activeLessonId fields
      allow update, delete: if isAdmin() || isSpaceOwner(spaceId);

      // Space-level lessons docs (assignment/attachments)
      match /lessons/{lessonId} {
        // If you store a copy of lesson content here, students can read it
        allow read: if true;

        // Only space owner/admin can write
        allow create, update, delete: if isAdmin()
          || (
            signedIn()
            && hasAttested()
            && isSpaceOwner(spaceId)
          );
      }

      // Submissions under space+lesson
      match /lessons/{lessonId}/submissions/{subId} {

        // Egen innlevering hvis auth.uid matcher (for innlogget/anon auth).
        function isOwnSubmission() {
          return signedIn()
            && (resource != null)
            && (resource.data.auth is map)
            && ("uid" in resource.data.auth)
            && resource.data.auth.uid == myUid();
        }

        function changedKeys() {
          return request.resource.data.diff(resource.data).changedKeys();
        }

        function onlyTeacherFieldsChanged() {
          return changedKeys().hasOnly(["status", "teacherFeedback"]);
        }

        function validAuthOnCreate() {
          return (
            // Firebase anonymous auth
            (isAnonAuth()
              && request.resource.data.auth is map
              && request.resource.data.auth.isAnon == true
              && request.resource.data.auth.uid == myUid()
            )
            ||
            // Vanlig innlogget bruker
            (!isAnonAuth()
              && signedIn()
              && request.resource.data.auth is map
              && request.resource.data.auth.isAnon == false
              && request.resource.data.auth.uid == myUid()
            )
          );
        }

        // ✅ Create: only if space is open AND caller is signed in (anon ok)
        allow create: if signedIn()
          && spaceIsOpen(spaceId)
          && request.resource.data.spaceId == spaceId
          && request.resource.data.lessonId == lessonId
          && request.resource.data.status == "new"
          && !("teacherFeedback" in request.resource.data)
          && request.resource.data.auth is map
          && validAuthOnCreate();

        // ✅ Read: admin, space owner, or own submission
        allow read: if isAdmin() || isSpaceOwner(spaceId) || isOwnSubmission();

        // ✅ Update: only teacher/admin, only feedback/status, lock other fields
        allow update: if isAdmin()
          || (
            isSpaceOwner(spaceId)
            && resource != null
            && onlyTeacherFieldsChanged()
            && request.resource.data.spaceId == spaceId
            && request.resource.data.lessonId == lessonId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.answers == resource.data.answers
            && request.resource.data.auth == resource.data.auth
          );

        allow delete: if false;
      }
    }

    /* ============================
       SUBMISSIONS (uten space)
       /submissions/{id}
    ============================ */
    match /submissions/{id} {

      function isOwnSubmissionId() {
        return signedIn() && id.matches('^' + myUid() + '_');
      }

      function isOwnerDoc() {
        return signedIn() && resource != null && resource.data.uid == myUid();
      }

      allow create: if signedIn()
        && request.resource.data.uid == myUid();

      allow read: if isAdmin()
        || (
          signedIn()
          && (
            (resource != null && resource.data.uid == myUid())
            || (resource == null && isOwnSubmissionId())
          )
        );

      allow update: if isAdmin()
        || (
          isOwnerDoc()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.publishedLessonId == resource.data.publishedLessonId
        );

      allow delete: if false;
    }

    /* ============================
       DEFAULT DENY
    ============================ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}