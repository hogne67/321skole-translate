rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helpers (null-safe)
    ========================= */
    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(myUid());
    }
    function myUserExists() {
      return signedIn() && exists(myUserPath());
    }
    function myUser() {
      return myUserExists() ? get(myUserPath()).data : {};
    }

    function isMap(x) { return x is map; }
    function isString(x) { return x is string; }
    function nonEmptyString(x) { return isString(x) && x.size() > 0; }

    function mapHasTrue(m, key) { return isMap(m) && (key in m) && m[key] == true; }
    function hasRole(roleName) { return mapHasTrue(myUser().roles, roleName); }

    /* =========================
       Role helpers
    ========================= */
    function myRole() {
      return ("role" in myUser() && (myUser().role is string)) ? myUser().role : "student";
    }

    function isTeacher() { return signedIn() && myRole() == "teacher"; }
    function isParent() { return signedIn() && myRole() == "parent"; }

    function isAdmin() {
      return signedIn() && (myRole() == "admin" || hasRole("admin"));
    }

    /* =========================
       Space helpers
    ========================= */
    function memberDocId(spaceId, uid) { return spaceId + "_" + uid; }

    function spacePath(spaceId) {
      return /databases/$(database)/documents/spaces/$(spaceId);
    }
    function spaceExists(spaceId) {
      return (spaceId is string) && exists(spacePath(spaceId));
    }
    function spaceData(spaceId) {
      return spaceExists(spaceId) ? get(spacePath(spaceId)).data : {};
    }

    function isSpaceOwner(spaceId) {
      return signedIn()
        && spaceExists(spaceId)
        && ("ownerId" in spaceData(spaceId))
        && (spaceData(spaceId).ownerId is string)
        && spaceData(spaceId).ownerId == myUid();
    }

    function spaceIsOpen(spaceId) {
      return spaceExists(spaceId)
        && ("isOpen" in spaceData(spaceId))
        && (spaceData(spaceId).isOpen is bool)
        && spaceData(spaceId).isOpen == true;
    }

    function myMemberPath(spaceId) {
      return /databases/$(database)/documents/spaceMembers/$(memberDocId(spaceId, myUid()));
    }
    function isSpaceMember(spaceId) {
      return signedIn() && (spaceId is string) && exists(myMemberPath(spaceId));
    }

    function spaceCode(spaceId) {
      return spaceExists(spaceId)
        && ("code" in spaceData(spaceId))
        && (spaceData(spaceId).code is string)
        ? spaceData(spaceId).code
        : null;
    }
    function spaceJoinCode(spaceId) {
      return spaceExists(spaceId)
        && ("joinCode" in spaceData(spaceId))
        && (spaceData(spaceId).joinCode is string)
        ? spaceData(spaceId).joinCode
        : null;
    }
    function spaceJoinDotCode(spaceId) {
      return spaceExists(spaceId)
        && ("join" in spaceData(spaceId))
        && isMap(spaceData(spaceId).join)
        && ("code" in spaceData(spaceId).join)
        && (spaceData(spaceId).join.code is string)
        ? spaceData(spaceId).join.code
        : null;
    }
    function reqJoinCode() {
      return (request.resource != null
        && request.resource.data is map
        && ("code" in request.resource.data)
        && (request.resource.data.code is string))
        ? request.resource.data.code
        : null;
    }
    function joinCodeMatches(spaceId) {
      return reqJoinCode() != null && (
        (spaceCode(spaceId) != null && reqJoinCode() == spaceCode(spaceId))
        || (spaceJoinCode(spaceId) != null && reqJoinCode() == spaceJoinCode(spaceId))
        || (spaceJoinDotCode(spaceId) != null && reqJoinCode() == spaceJoinDotCode(spaceId))
      );
    }

    function reqSpaceKind() {
      return (request.resource != null
        && request.resource.data is map
        && ("kind" in request.resource.data)
        && (request.resource.data.kind is string))
        ? request.resource.data.kind
        : null;
    }

    function spaceKind(spaceId) {
      return spaceExists(spaceId)
        && ("kind" in spaceData(spaceId))
        && (spaceData(spaceId).kind is string)
        ? spaceData(spaceId).kind
        : null;
    }

    function teacherSpaceCreateOk() {
      return (isTeacher() || isAdmin())
        && (
          reqSpaceKind() == null
          || reqSpaceKind() == "class"
        );
    }

    function parentSpaceCreateOk() {
      return isParent()
        && (
          reqSpaceKind() == "family"
          || reqSpaceKind() == "parent_group"
        );
    }

    /* =========================
       SPACE BOARD (per-space)
    ========================= */
    function canBoardManage(spaceId) {
      return signedIn() && (
        isAdmin()
        || isSpaceOwner(spaceId)
        || (isTeacher() && isSpaceMember(spaceId))
      );
    }

    function boardStatePath(spaceId) {
      return /databases/$(database)/documents/spaces/$(spaceId)/board/state;
    }
    function boardStateExists(spaceId) {
      return (spaceId is string) && exists(boardStatePath(spaceId));
    }
    function boardState(spaceId) {
      return boardStateExists(spaceId) ? get(boardStatePath(spaceId)).data : {};
    }
    function boardActive(spaceId) {
      return boardStateExists(spaceId)
        && ("active" in boardState(spaceId))
        && (boardState(spaceId).active is bool)
        && boardState(spaceId).active == true;
    }
    function boardSessionId(spaceId) {
      return boardStateExists(spaceId)
        && ("sessionId" in boardState(spaceId))
        && (boardState(spaceId).sessionId is string)
        ? boardState(spaceId).sessionId
        : null;
    }

    match /spaces/{spaceId}/board/{docId} {
      allow read: if signedIn() && (isAdmin() || isSpaceOwner(spaceId) || isSpaceMember(spaceId));
      allow create, update, delete: if canBoardManage(spaceId);
    }

    match /spaces/{spaceId}/boardResponses/{responseId} {
      allow read: if canBoardManage(spaceId)
        || (signedIn() && responseId.matches('^.+_' + myUid() + '$'));

      function isTextResponseId() {
        return responseId.matches('^.+_' + myUid() + '$');
      }
      function textKeysOk() {
        return request.resource.data.keys().hasOnly([
          "sessionId",
          "uid",
          "displayName",
          "groupName",
          "text",
          "noteColor",
          "createdAt"
        ]);
      }
      function textPayloadOk() {
        return nonEmptyString(request.resource.data.sessionId)
          && boardSessionId(spaceId) != null
          && request.resource.data.sessionId == boardSessionId(spaceId)
          && boardActive(spaceId)
          && nonEmptyString(request.resource.data.uid)
          && request.resource.data.uid == myUid()
          && nonEmptyString(request.resource.data.text);
      }

      function isPollResponseId() {
        return responseId.matches('^.+_anon_.+$');
      }
      function pollKeysOk() {
        return request.resource.data.keys().hasOnly([
          "sessionId",
          "pollChoice",
          "createdAt"
        ]);
      }
      function pollPayloadOk() {
        return nonEmptyString(request.resource.data.sessionId)
          && boardSessionId(spaceId) != null
          && request.resource.data.sessionId == boardSessionId(spaceId)
          && boardActive(spaceId)
          && nonEmptyString(request.resource.data.pollChoice);
      }

      allow create: if signedIn()
        && isSpaceMember(spaceId)
        && (
          canBoardManage(spaceId)
          || (isTextResponseId() && textKeysOk() && textPayloadOk())
          || (isPollResponseId() && pollKeysOk() && pollPayloadOk())
        );

      allow update: if signedIn()
        && isSpaceMember(spaceId)
        && (
          canBoardManage(spaceId)
          || (
            isTextResponseId()
            && textKeysOk()
            && textPayloadOk()
            && request.resource.data.sessionId == resource.data.sessionId
            && ("uid" in resource.data)
            && (resource.data.uid is string)
            && resource.data.uid == myUid()
          )
        );

      allow delete: if canBoardManage(spaceId);
    }

    /* =========================
       USERS
    ========================= */
    match /users/{uid} {
      function isSelf() { return signedIn() && myUid() == uid; }
      function changedKeys() { return request.resource.data.diff(resource.data).changedKeys(); }
      function isChanging(field) { return changedKeys().hasAny([field]); }

      function roleOk() {
        return !isChanging("role")
          || (
            (request.resource.data.role is string)
            && (
              request.resource.data.role == "student"
              || request.resource.data.role == "teacher"
              || request.resource.data.role == "parent"
            )
          );
      }

      function rolesNotChangedBySelf() { return !isChanging("roles"); }

      allow create: if isSelf();
      allow read: if isSelf() || isAdmin();
      allow update: if isAdmin() || (isSelf() && rolesNotChangedBySelf() && roleOk());
      allow delete: if false;
    }

    /* =========================
       SPACE MEMBERS
    ========================= */
    match /spaceMembers/{docId} {

  function resUidAny() {
    return (resource != null
      && (
        (("uid" in resource.data) && (resource.data.uid is string) && resource.data.uid)
        || (("userId" in resource.data) && (resource.data.userId is string) && resource.data.userId)
      ))
      ? (("uid" in resource.data) ? resource.data.uid : resource.data.userId)
      : null;
  }

  function reqUidAny() {
    return (request.resource != null
      && request.resource.data is map
      && (
        (("uid" in request.resource.data) && (request.resource.data.uid is string) && request.resource.data.uid)
        || (("userId" in request.resource.data) && (request.resource.data.userId is string) && request.resource.data.userId)
      ))
      ? (("uid" in request.resource.data) ? request.resource.data.uid : request.resource.data.userId)
      : null;
  }

  function isSelfMemberDoc() {
    return signedIn() && (
      (resUidAny() != null && resUidAny() == myUid())
      || (reqUidAny() != null && reqUidAny() == myUid())
    );
  }

  function docUidFromId() {
    let parts = docId.split("_");
    return parts.size() > 0 ? parts[parts.size() - 1] : "";
  }

  function displayNameOk() {
    return !(request.resource.data is map) ? true
      : !("displayName" in request.resource.data) ? true
      : (
          (request.resource.data.displayName is string)
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 80
        );
  }

  allow read: if isAdmin()
    || (signedIn() && docUidFromId() == myUid())
    || (resource != null
        && ("uid" in resource.data)
        && (resource.data.uid is string)
        && resource.data.uid == myUid())
    || (resource != null
        && ("userId" in resource.data)
        && (resource.data.userId is string)
        && resource.data.userId == myUid())
    || (resource != null
        && ("spaceId" in resource.data)
        && (resource.data.spaceId is string)
        && isSpaceOwner(resource.data.spaceId));

  allow create: if signedIn()
  && (request.resource.data.spaceId is string)
  && (request.resource.data.uid is string)
  && request.resource.data.uid == myUid()
  && docId == (request.resource.data.spaceId + "_" + request.resource.data.uid);

allow update: if signedIn()
  && resource != null
  && (
    (("uid" in resource.data) && resource.data.uid == myUid())
    || (("spaceId" in resource.data) && isSpaceOwner(resource.data.spaceId))
    || isAdmin()
  );

  allow update: if signedIn()
    && resource != null
    && (resource.data.spaceId is string)
    && displayNameOk()
    && (isSelfMemberDoc() || isSpaceOwner(resource.data.spaceId) || isAdmin());

  allow delete: if false;
}

    /* =========================
       LESSONS
    ========================= */
    match /lessons/{lessonId} {
      function isOwner() {
        return signedIn()
          && resource != null
          && ("ownerId" in resource.data)
          && (resource.data.ownerId is string)
          && resource.data.ownerId == myUid();
      }

      function isPublishedForStudents() {
        return resource != null && (
          (("status" in resource.data) && (resource.data.status == "published" || resource.data.status == "unlisted"))
          || (("isActive" in resource.data) && resource.data.isActive == true)
        );
      }

      allow get: if signedIn() || isAdmin() || isOwner();
      allow list: if isAdmin() || isOwner() || (signedIn() && isPublishedForStudents());
      allow create: if false;
      allow update: if isOwner();
      allow delete: if false;
    }

    /* =========================
       PUBLISHED LESSONS
    ========================= */
    match /published_lessons/{id} {
      function pubIsActive() {
        return resource != null
          && (
            (("isActive" in resource.data) && resource.data.isActive == true)
            || (("status" in resource.data) && (resource.data.status == "published" || resource.data.status == "unlisted"))
            || (("published" in resource.data) && resource.data.published == true)
          );
      }

      allow read: if pubIsActive() || isAdmin();
      allow write: if false;
    }

    /* =========================
       SPACES
    ========================= */
    match /spaces/{spaceId} {
  allow read: if true;

  allow create: if signedIn()
    && (request.resource.data.ownerId is string)
    && request.resource.data.ownerId == myUid()
    && (request.resource.data.title is string)
    && request.resource.data.title.size() > 0
    && (request.resource.data.isOpen is bool)
    && (
      isAdmin()
      || (
        isTeacher()
        && (
          !("kind" in request.resource.data)
          || request.resource.data.kind == "class"
        )
      )
      || (
        isParent()
        && ("kind" in request.resource.data)
        && (
          request.resource.data.kind == "family"
          || request.resource.data.kind == "parent_group"
        )
      )
    );

  allow update, delete: if isAdmin() || isSpaceOwner(spaceId);
}

    /* =========================
       SPACE-LOCAL ASSIGNMENTS
    ========================= */
    match /spaces/{spaceId}/lessons/{assignmentId} {
      allow read: if isAdmin() || isSpaceOwner(spaceId) || isSpaceMember(spaceId) || spaceIsOpen(spaceId);
      allow create, update, delete: if isAdmin() || isSpaceOwner(spaceId);
    }

    /* =========================
       SPACE-LOCAL SUBMISSIONS
    ========================= */
    match /spaces/{spaceId}/lessons/{assignmentId}/submissions/{subId} {

  function isSubOwner() {
    return signedIn()
      && resource != null
      && ("uid" in resource.data)
      && (resource.data.uid is string)
      && (resource.data.uid == myUid());
  }

  function isOwnSubmissionId() {
    return signedIn()
      && subId == (spaceId + "_" + assignmentId + "_" + myUid());
  }

  function canTeacherReadHere() {
    return signedIn() && (
      isSpaceOwner(spaceId)
      || isAdmin()
      || (isTeacher() && isSpaceMember(spaceId))
    );
  }

  function canParentReadOwnHere() {
    return signedIn()
      && isParent()
      && isSpaceMember(spaceId)
      && isOwnSubmissionId();
  }

  allow read: if
    isAdmin()
    || isSubOwner()
    || canTeacherReadHere()
    || canParentReadOwnHere();

  allow create: if signedIn()
    && (request.resource.data.uid is string)
    && request.resource.data.uid == myUid()
    && isSpaceMember(spaceId);

  allow update: if
    isAdmin()
    || isSpaceOwner(spaceId)
    || isSubOwner()
    || canParentReadOwnHere();

  allow delete: if false;
}
match /spaces/{spaceId}/lessons/{assignmentId}/parentReviews/{uid} {

  function isOwnParentReview() {
    return signedIn() && uid == myUid();
  }

  allow read: if
    isAdmin()
    || isSpaceOwner(spaceId)
    || isOwnParentReview();

  allow create, update: if
    signedIn()
    && isParent()
    && isSpaceMember(spaceId)
    && isOwnParentReview();

  allow delete: if false;
}

    /* =========================
       SPACE SUBMISSIONS INDEX
    ========================= */
    match /spaceSubmissions/{id} {

      function isOwnerDoc() {
        return signedIn()
          && resource != null
          && ("uid" in resource.data)
          && (resource.data.uid is string)
          && (resource.data.uid == myUid());
      }

      function spaceIdFromDoc() {
        return (resource != null && ("spaceId" in resource.data) && (resource.data.spaceId is string))
          ? resource.data.spaceId
          : null;
      }

      function canTeacherReadIndex() {
        return signedIn()
          && spaceIdFromDoc() != null
          && (
            isSpaceOwner(spaceIdFromDoc())
            || isAdmin()
            || (isTeacher() && isSpaceMember(spaceIdFromDoc()))
          );
      }

      allow read: if isAdmin() || isOwnerDoc() || canTeacherReadIndex();

      allow create: if signedIn()
        && (request.resource.data.uid is string)
        && request.resource.data.uid == myUid()
        && (request.resource.data.spaceId is string)
        && isSpaceMember(request.resource.data.spaceId);

      allow update: if isAdmin()
        || isOwnerDoc()
        || (signedIn() && spaceIdFromDoc() != null && isSpaceOwner(spaceIdFromDoc()));

      allow delete: if false;
    }

    /* =========================
       PRACTICE SUBMISSIONS
    ========================= */
    match /practiceSubmissions/{id} {
      function isOwnerDoc() {
        return signedIn()
          && resource != null
          && ("uid" in resource.data)
          && (resource.data.uid is string)
          && resource.data.uid == myUid();
      }

      allow create: if signedIn()
        && (request.resource.data.uid is string)
        && request.resource.data.uid == myUid();

      allow read: if isAdmin() || isOwnerDoc();
      allow update: if isAdmin() || isOwnerDoc();
      allow delete: if false;
    }

    /* =========================
       LEGACY SUBMISSIONS
    ========================= */
    match /submissions/{id} {
      function isOwnerDoc() {
        return signedIn()
          && resource != null
          && ("uid" in resource.data)
          && (resource.data.uid is string)
          && (resource.data.uid == myUid());
      }

      allow read: if isAdmin() || isOwnerDoc();
      allow create, update, delete: if false;
    }

    /* =========================
       GLOBAL SUBMISSIONS
    ========================= */
    match /{document=**}/submissions/{subId} {
      allow get, list: if signedIn()
        && (
          (("uid" in resource.data) && (resource.data.uid is string) && resource.data.uid == myUid())
          || (("userId" in resource.data) && (resource.data.userId is string) && resource.data.userId == myUid())
        );

      allow create, update, delete: if false;
    }

    /* =========================
       Default deny
    ========================= */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}