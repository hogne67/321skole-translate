rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helpers (null-safe)
    ========================= */
    function signedIn() { return request.auth != null; }
    function accountEnabled() {
      let profile = myUser();
      return signedIn() && profile.get("disabled", false) != true
        && profile.get("authDisabled", false) != true
        && (!("authRevokedBefore" in profile) || (profile.authRevokedBefore is number
          && profile.authRevokedBefore >= 0 && request.auth.token.get("auth_time", 0) is number
          && request.auth.token.get("auth_time", 0) > profile.authRevokedBefore));
    }
    function myUid() { return request.auth.uid; }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(myUid());
    }
    function myUserExists() {
      return signedIn() && exists(myUserPath());
    }
    function myUser() {
      return myUserExists() ? get(myUserPath()).data : {};
    }

    function isMap(x) { return x is map; }
    function isString(x) { return x is string; }
    function nonEmptyString(x) { return isString(x) && x.size() > 0; }

    function mapHasTrue(m, key) { return isMap(m) && (key in m) && m[key] == true; }
    function hasRole(roleName) { return ("roles" in myUser()) && mapHasTrue(myUser().roles, roleName); }

    /* =========================
       Role helpers
    ========================= */
    function myRole() {
      return ("role" in myUser() && (myUser().role is string)) ? myUser().role : "student";
    }

    function isTeacher() { return signedIn() && myRole() == "teacher"; }
    function isParent() { return signedIn() && myRole() == "parent"; }

    function isAdmin() {
      let profile = myUser();
      return signedIn() && (profile.get("role", "student") == "admin" || mapHasTrue(profile.get("roles", {}), "admin"));
    }

    function hasActiveSchoolProfile() {
      return signedIn()
        && ("schoolId" in myUser())
        && (myUser().schoolId is string)
        && ("schoolStatus" in myUser())
        && myUser().schoolStatus == "active";
    }

    /* =========================
       Space helpers
    ========================= */
    function memberDocId(spaceId, uid) { return spaceId + "_" + uid; }

    function spacePath(spaceId) {
      return /databases/$(database)/documents/spaces/$(spaceId);
    }
    function spaceExists(spaceId) {
      return (spaceId is string) && exists(spacePath(spaceId));
    }
    function spaceData(spaceId) {
      return spaceExists(spaceId) ? get(spacePath(spaceId)).data : {};
    }

    function isSpaceOwner(spaceId) {
      let space = spaceData(spaceId);
      return signedIn() && spaceOwnerUid(space) == myUid()
        && (!exists(myMemberPath(spaceId)) || isActiveSpaceMemberData(get(myMemberPath(spaceId)).data));
    }

    function validSpaceOwnerUid(value) {
      return value is string && value.size() > 0 && value.size() <= 128
        && value.matches('[^/ \\t\\r\\n]+');
    }

    function spaceOwnerUid(data) {
      let id = data.get("ownerId", null);
      let legacy = data.get("ownerUid", null);
      return "ownerId" in data
        ? (validSpaceOwnerUid(id) && (!("ownerUid" in data) || legacy == id) ? id : null)
        : ("ownerUid" in data && validSpaceOwnerUid(legacy) ? legacy : null);
    }

    function spaceIsOpen(spaceId) {
      return spaceExists(spaceId)
        && ("isOpen" in spaceData(spaceId))
        && (spaceData(spaceId).isOpen is bool)
        && spaceData(spaceId).isOpen == true;
    }

    function myMemberPath(spaceId) {
      return /databases/$(database)/documents/spaceMembers/$(memberDocId(spaceId, myUid()));
    }
    function isSpaceMember(spaceId) {
      return signedIn() && (spaceId is string) && exists(myMemberPath(spaceId))
        && isActiveSpaceMemberData(get(myMemberPath(spaceId)).data);
    }

    function mySpaceMemberData(spaceId) {
      return isSpaceMember(spaceId) ? get(myMemberPath(spaceId)).data : {};
    }

    function isActiveSpaceMemberData(data) {
      let status = data.get("status", "");
      return isMap(data)
        && data.get("role", "") != "school_admin"
        && status is string && status.lower().matches('[ \\t\\r\\n]*active[ \\t\\r\\n]*')
        && data.get("active", true) == true
        && data.get("archived", false) == false;
    }

    function isSpaceCoTeacher(spaceId) {
      let member = mySpaceMemberData(spaceId);
      return signedIn()
        && (
          (("role" in member) && (member.role == "teacher" || member.role == "co_teacher"))
          || (("staffRole" in member) && (member.staffRole == "co_teacher" || member.staffRole == "substitute"))
        );
    }

    function canTeachInSpace(spaceId) {
      return isSpaceOwner(spaceId) || isSpaceCoTeacher(spaceId) || isAdmin();
    }

    function spaceCode(spaceId) {
      return spaceExists(spaceId)
        && ("code" in spaceData(spaceId))
        && (spaceData(spaceId).code is string)
        ? spaceData(spaceId).code
        : null;
    }
    function spaceJoinCode(spaceId) {
      return spaceExists(spaceId)
        && ("joinCode" in spaceData(spaceId))
        && (spaceData(spaceId).joinCode is string)
        ? spaceData(spaceId).joinCode
        : null;
    }
    function spaceJoinDotCode(spaceId) {
      return spaceExists(spaceId)
        && ("join" in spaceData(spaceId))
        && isMap(spaceData(spaceId).join)
        && ("code" in spaceData(spaceId).join)
        && (spaceData(spaceId).join.code is string)
        ? spaceData(spaceId).join.code
        : null;
    }
    function reqJoinCode() {
      return (request.resource != null
        && request.resource.data is map
        && ("code" in request.resource.data)
        && (request.resource.data.code is string))
        ? request.resource.data.code
        : null;
    }
    function joinCodeMatches(spaceId) {
      return reqJoinCode() != null && (
        (spaceCode(spaceId) != null && reqJoinCode() == spaceCode(spaceId))
        || (spaceJoinCode(spaceId) != null && reqJoinCode() == spaceJoinCode(spaceId))
        || (spaceJoinDotCode(spaceId) != null && reqJoinCode() == spaceJoinDotCode(spaceId))
      );
    }

    function reqSpaceKind() {
      return (request.resource != null
        && request.resource.data is map
        && ("kind" in request.resource.data)
        && (request.resource.data.kind is string))
        ? request.resource.data.kind
        : null;
    }

    function spaceKind(spaceId) {
      return spaceExists(spaceId)
        && ("kind" in spaceData(spaceId))
        && (spaceData(spaceId).kind is string)
        ? spaceData(spaceId).kind
        : null;
    }

    function teacherSpaceCreateOk() {
      return (isTeacher() || isAdmin())
        && (
          reqSpaceKind() == null
          || reqSpaceKind() == "class"
        );
    }

    function parentSpaceCreateOk() {
      return isParent()
        && (
          reqSpaceKind() == "family"
          || reqSpaceKind() == "parent_group"
        );
    }

    function requestedSchoolIdOk() {
      return !("schoolId" in request.resource.data)
        || request.resource.data.schoolId == null
        || (
          (isTeacher() || isAdmin())
          && hasActiveSchoolProfile()
          && nonEmptyString(request.resource.data.schoolId)
          && !request.resource.data.schoolId.matches('.*[/].*')
          && request.resource.data.schoolId == myUser().schoolId
          && activeSchoolSpaceCreator(request.resource.data.schoolId)
        );
    }

    function activeSchoolSpaceCreator(schoolId) {
      let schoolPath = /databases/$(database)/documents/schools/$(schoolId);
      let memberPath = /databases/$(database)/documents/schools/$(schoolId)/members/$(myUid());
      let school = exists(schoolPath) ? get(schoolPath).data : {};
      let member = exists(memberPath) ? get(memberPath).data : {};
      return school.get("status", "") == "active"
        && school.get("teacherSeatLimit", 0) is int && school.get("teacherSeatLimit", 0) > 0
        && member.get("uid", "") == myUid()
        && member.get("schoolId", schoolId) == schoolId
        && member.get("status", "") == "active"
        && member.get("role", "") in ["school_teacher", "school_admin"]
        && member.get("role", "") == myUser().get("schoolRole", "");
    }

    function validParentGoalBase(data) {
      return data.keys().hasOnly([
          "title",
          "description",
          "status",
          "kind",
          "targetCount",
          "assignmentIds",
          "createdByUid",
          "createdAt",
          "updatedAt",
          "completedAt"
        ])
        && data.keys().hasAll([
          "title",
          "status",
          "kind",
          "createdByUid",
          "createdAt",
          "updatedAt"
        ])
        && (data.title is string)
        && data.title.size() > 0
        && data.title.size() <= 120
        && (!("description" in data) || (data.description is string && data.description.size() <= 500))
        && (data.status in ["active", "completed", "archived"])
        && (data.kind in ["complete_assignments", "custom"])
        && (data.createdByUid is string)
        && data.createdByUid == myUid()
        && (!("targetCount" in data) || (data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 100))
        && (!("assignmentIds" in data) || data.assignmentIds is list);
    }

    function validParentGoalCreate() {
      return validParentGoalBase(request.resource.data);
    }

    function validParentGoalUpdate() {
      return validParentGoalBase(request.resource.data)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    /* =========================
       SPACE BOARD (per-space)
    ========================= */
    function canBoardManage(spaceId) {
      return signedIn() && (
        isAdmin()
        || isSpaceOwner(spaceId)
        || isSpaceCoTeacher(spaceId)
      );
    }

    function boardStatePath(spaceId) {
      return /databases/$(database)/documents/spaces/$(spaceId)/board/state;
    }
    function boardStateExists(spaceId) {
      return (spaceId is string) && exists(boardStatePath(spaceId));
    }
    function boardState(spaceId) {
      return boardStateExists(spaceId) ? get(boardStatePath(spaceId)).data : {};
    }
    function boardActive(spaceId) {
      return boardStateExists(spaceId)
        && ("active" in boardState(spaceId))
        && (boardState(spaceId).active is bool)
        && boardState(spaceId).active == true;
    }
    function boardSessionId(spaceId) {
      return boardStateExists(spaceId)
        && ("sessionId" in boardState(spaceId))
        && (boardState(spaceId).sessionId is string)
        ? boardState(spaceId).sessionId
        : null;
    }

    match /spaces/{spaceId}/board/{docId} {
      allow read: if accountEnabled() && (signedIn() && (isAdmin() || isSpaceOwner(spaceId) || isSpaceMember(spaceId)));
      allow create, update, delete: if accountEnabled() && (canBoardManage(spaceId));
    }

    match /spaces/{spaceId}/boardResponses/{responseId} {
  allow read: if accountEnabled() && (canBoardManage(spaceId)
    || (isSpaceMember(spaceId) && responseId.matches('^.+_' + myUid() + '$')));

  function isTextResponseId() {
    return responseId.matches('^.+_text_.+$')
      || responseId.matches('^.+_' + myUid() + '$');
  }
  function textKeysOk() {
    return request.resource.data.keys().hasOnly([
      "sessionId",
      "uid",
      "displayName",
      "groupName",
      "text",
      "noteColor",
      "createdAt"
    ]);
  }
  function textPayloadOk() {
    return nonEmptyString(request.resource.data.sessionId)
      && boardSessionId(spaceId) != null
      && request.resource.data.sessionId == boardSessionId(spaceId)
      && boardActive(spaceId)
      && nonEmptyString(request.resource.data.uid)
      && request.resource.data.uid == myUid()
      && nonEmptyString(request.resource.data.text);
  }

  function isPollResponseId() {
    return responseId.matches('^.+_anon_.+$');
  }
  function pollKeysOk() {
    return request.resource.data.keys().hasOnly([
      "sessionId",
      "pollChoice",
      "createdAt"
    ]);
  }
  function pollPayloadOk() {
    return nonEmptyString(request.resource.data.sessionId)
      && boardSessionId(spaceId) != null
      && request.resource.data.sessionId == boardSessionId(spaceId)
      && boardActive(spaceId)
      && nonEmptyString(request.resource.data.pollChoice);
  }

  function isWordwallResponseId() {
    return responseId.matches('^.+_word_.+$');
  }
  function wordwallKeysOk() {
    return request.resource.data.keys().hasOnly([
      "sessionId",
      "wordwallWord",
      "createdAt"
    ]);
  }
  function wordwallPayloadOk() {
    return nonEmptyString(request.resource.data.sessionId)
      && boardSessionId(spaceId) != null
      && request.resource.data.sessionId == boardSessionId(spaceId)
      && boardActive(spaceId)
      && nonEmptyString(request.resource.data.wordwallWord);
  }

  allow create: if accountEnabled() && (signedIn()
    && isSpaceMember(spaceId)
    && (
      canBoardManage(spaceId)
      || (isTextResponseId() && textKeysOk() && textPayloadOk())
      || (isPollResponseId() && pollKeysOk() && pollPayloadOk())
      || (isWordwallResponseId() && wordwallKeysOk() && wordwallPayloadOk())
    ));

  allow update: if accountEnabled() && (signedIn()
    && isSpaceMember(spaceId)
    && (
      canBoardManage(spaceId)
      || (
        isTextResponseId()
        && textKeysOk()
        && textPayloadOk()
        && request.resource.data.sessionId == resource.data.sessionId
        && ("uid" in resource.data)
        && (resource.data.uid is string)
        && resource.data.uid == myUid()
      )
    ));

  allow delete: if accountEnabled() && (canBoardManage(spaceId));
}

    /* =========================
       USERS
    ========================= */
    match /users/{uid} {
  function isSelf() { return signedIn() && myUid() == uid; }
  function profileKeys() {
    return ["uid", "displayName", "email", "locale", "legal", "role", "studentAccessMode",
      "onboardingComplete", "org", "institutionType", "municipality", "createdAt", "updatedAt",
      "lastLoginAt", "mode", "attestation", "creatorStatus", "creatorAppliedAt"];
  }
  function safeProfileValues() {
    return (!("uid" in request.resource.data) || request.resource.data.uid == uid)
      && (!("studentAccessMode" in request.resource.data) || request.resource.data.studentAccessMode in ["space_only", "self_study"]);
  }
  function orgKeys() { return ["country", "municipality", "institutionType", "institutionName"]; }
  function safeOrgCreate() {
    return !("org" in request.resource.data) || (request.resource.data.org is map && request.resource.data.org.keys().hasOnly(orgKeys()));
  }
  function safeOrgUpdate() {
    return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["org"])
      || (request.resource.data.org is map
        && request.resource.data.org.diff(resource.data.get("org", {})).affectedKeys().hasOnly(orgKeys()));
  }
  function safeRole() {
    return !("role" in request.resource.data) || request.resource.data.role in ["student", "teacher", "parent"];
  }
  function safeMode() {
    return !("mode" in request.resource.data) || request.resource.data.mode in ["student", "teacher", "parent"]
      || (request.resource.data.mode == "creator" && resource != null
        && (resource.data.get("role", "") in ["teacher", "creator"]
          || mapHasTrue(resource.data.get("roles", {}), "creator") || mapHasTrue(resource.data.get("roles", {}), "teacher")))
      || (request.resource.data.mode == "admin" && resource != null
        && (resource.data.get("role", "") == "admin" || mapHasTrue(resource.data.get("roles", {}), "admin")));
  }
  function safeCreatorApplication() {
    return !("creatorStatus" in request.resource.data) || request.resource.data.creatorStatus == "pending";
  }

  allow create: if accountEnabled() && ((isAdmin() && !isSelf()) || (isSelf()
    && request.resource.data.keys().hasOnly(profileKeys().concat(["disabled"]))
    && (!("disabled" in request.resource.data) || request.resource.data.disabled == false)
    && safeRole() && safeMode() && safeCreatorApplication() && safeProfileValues() && safeOrgCreate()));
  allow read: if accountEnabled() && (isSelf() || isAdmin());
  allow update: if accountEnabled() && ((isAdmin() && !isSelf()) || (isSelf()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys())
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]) || safeRole())
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["mode"]) || safeMode())
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["creatorStatus"]) || safeCreatorApplication())
    && safeProfileValues() && safeOrgUpdate()));
  allow delete: if false;

  match /usage/{monthId} {
    function usageKeys() { return ["premium_generators", "image_generation", "ai_feedback", "downloads", "members", "app_access", "updatedAt"]; }
    function counterOk(key) {
      return request.resource.data.get(key, 0) is number && request.resource.data.get(key, 0) >= 0;
    }
    function counterNotReduced(key) {
      return request.resource.data.get(key, 0) >= resource.data.get(key, 0);
    }
    function countersOk() {
      return counterOk("premium_generators") && counterOk("image_generation") && counterOk("ai_feedback")
        && counterOk("downloads") && counterOk("members") && counterOk("app_access");
    }
    allow read: if accountEnabled() && (signedIn() && myUid() == uid);
    allow create: if accountEnabled() && (isSelf() && request.resource.data.keys().hasOnly(usageKeys()) && countersOk());
    allow update: if accountEnabled() && (isSelf() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(usageKeys()) && countersOk()
      && counterNotReduced("premium_generators") && counterNotReduced("image_generation") && counterNotReduced("ai_feedback")
      && counterNotReduced("downloads") && counterNotReduced("members") && counterNotReduced("app_access"));
    allow delete: if false;
  }

  match /geometryAttempts/{attemptId} {
    allow read, create, update: if accountEnabled() && (signedIn() && myUid() == uid);
    allow delete: if false;
  }
}

    /* =========================
       SPACE MEMBERS
    ========================= */
    match /spaceMembers/{docId} {

  function resUidAny() {
    return (resource != null
      && (
        (("uid" in resource.data) && (resource.data.uid is string) && resource.data.uid)
        || (("userId" in resource.data) && (resource.data.userId is string) && resource.data.userId)
      ))
      ? (("uid" in resource.data) ? resource.data.uid : resource.data.userId)
      : null;
  }

  function reqUidAny() {
    return (request.resource != null
      && request.resource.data is map
      && (
        (("uid" in request.resource.data) && (request.resource.data.uid is string) && request.resource.data.uid)
        || (("userId" in request.resource.data) && (request.resource.data.userId is string) && request.resource.data.userId)
      ))
      ? (("uid" in request.resource.data) ? request.resource.data.uid : request.resource.data.userId)
      : null;
  }

  function isSelfMemberDoc() {
    return signedIn() && (
      (resUidAny() != null && resUidAny() == myUid())
      || (reqUidAny() != null && reqUidAny() == myUid())
    );
  }

  function docUidFromId() {
    let parts = docId.split("_");
    return parts.size() > 0 ? parts[parts.size() - 1] : "";
  }

  function displayNameOk() {
    return !(request.resource.data is map) ? true
      : !("displayName" in request.resource.data) ? true
      : (
          (request.resource.data.displayName is string)
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 80
        );
  }

  function isOwnerMembership() {
    let owner = spaceOwnerUid(spaceData(resource.data.spaceId));
    return owner is string && docId == resource.data.spaceId + "_" + owner;
  }

  allow read: if accountEnabled() && (isAdmin()
    || (signedIn() && docUidFromId() == myUid())
    || (resource != null
        && ("uid" in resource.data)
        && (resource.data.uid is string)
        && resource.data.uid == myUid())
    || (resource != null
        && ("userId" in resource.data)
        && (resource.data.userId is string)
        && resource.data.userId == myUid())
    || (resource != null
        && ("spaceId" in resource.data)
        && (resource.data.spaceId is string)
        && (isSpaceOwner(resource.data.spaceId) || isSpaceCoTeacher(resource.data.spaceId))));

  // Pupil identities, personal codes and access links are created by validated server endpoints.
  allow create: if accountEnabled() && (signedIn()
    && request.resource.data.spaceId is string
    && request.resource.data.uid == myUid()
    && docId == request.resource.data.spaceId + "_" + myUid()
    && request.resource.data.role == "parent"
    && isActiveSpaceMemberData(request.resource.data)
    && isSpaceOwner(request.resource.data.spaceId)
    && spaceData(request.resource.data.spaceId).kind == "family");
  allow update: if accountEnabled() && (signedIn()
    && resource != null
    && (resource.data.spaceId is string)
    && request.resource.data.spaceId == resource.data.spaceId
    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacherStudentId'])
    && displayNameOk()
    && (isSpaceOwner(resource.data.spaceId) || isAdmin())
    && (isAdmin() || !isOwnerMembership()
      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "studentName", "updatedAt", "nameUpdatedAt", "nameUpdatedByUid"])));

  allow delete: if false;
}

    /* =========================
       LESSONS
    ========================= */
    match /lessons/{lessonId} {
      function isOwner() {
        return signedIn()
          && resource != null
          && ("ownerId" in resource.data)
          && (resource.data.ownerId is string)
          && resource.data.ownerId == myUid();
      }

      function isPublishedForStudents() {
        return resource != null
          && !("visibility" in resource.data && resource.data.visibility == "private")
          && !("publishVisibility" in resource.data && resource.data.publishVisibility == "private")
          && !("publish" in resource.data && resource.data.publish is map
            && "visibility" in resource.data.publish && resource.data.publish.visibility == "private")
          && (
          (("status" in resource.data) && (resource.data.status == "published" || resource.data.status == "unlisted"))
          || (("isActive" in resource.data) && resource.data.isActive == true)
        );
      }

      allow get: if accountEnabled() && (isAdmin() || isOwner() || (signedIn() && isPublishedForStudents()));
      allow list: if accountEnabled() && (isAdmin() || isOwner() || (signedIn() && isPublishedForStudents()));
      allow create: if false;
      allow update: if accountEnabled() && (isOwner()
        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if false;
    }

    /* =========================
       TEACHER WRITING LIBRARY
    ========================= */
    match /writingActivities/{activityId} {
      allow read: if accountEnabled() && (isAdmin()
        || (signedIn() && resource.data.ownerUid == myUid()));

      allow create: if accountEnabled() && (isAdmin()
        || (
          isTeacher()
          && request.resource.data.ownerUid == myUid()
        ));

      allow update, delete: if accountEnabled() && (isAdmin()
        || (signedIn() && resource.data.ownerUid == myUid()));
    }

    /* =========================
       PUBLISHED LESSONS
    ========================= */
    match /published_lessons/{id} {
  function pubIsActive() {
    return resource != null
      && (
        (("isActive" in resource.data) && resource.data.isActive == true)
        || (("status" in resource.data) && (resource.data.status == "published" || resource.data.status == "unlisted"))
        || (("published" in resource.data) && resource.data.published == true)
      );
  }

  allow read: if (pubIsActive() || accountEnabled()) && (pubIsActive() || isAdmin());

  allow update: if accountEnabled() && (signedIn()
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      "ratingCount",
      "ratingSum",
      "ratingAverage"
    ]));

  allow create, delete: if false;

  match /ratings/{uid} {
    allow read: if true;

    allow create, update: if accountEnabled() && (signedIn()
      && request.auth.uid == uid
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.value is int
      && request.resource.data.value >= 1
      && request.resource.data.value <= 5);

    allow delete: if accountEnabled() && (signedIn() && request.auth.uid == uid);
  }
}

    /* =========================
       COURSES / 321ACADEMY
    ========================= */
    match /courses/{courseId} {
      function courseKeys() {
        return [
          "ownerUid",
          "title",
          "description",
          "learningGoals",
          "targetAudience",
          "language",
          "level",
          "priceText",
          "maxParticipants",
          "numberOfSessions",
          "numberOfWeeks",
          "status",
          "slug",
          "publicUrl",
          "publishedAt",
          "coursePlan",
          "createdAt",
          "updatedAt"
        ];
      }

      function validCourseStatus(status) {
        return status == "draft"
          || status == "published"
          || status == "active"
          || status == "completed";
      }

      function validCoursePayload(data) {
        return data.keys().hasAll(courseKeys())
          && data.keys().hasOnly(courseKeys())
          && data.ownerUid is string
          && data.ownerUid == myUid()
          && data.title is string
          && data.description is string
          && data.learningGoals is string
          && data.targetAudience is string
          && data.language is string
          && data.level is string
          && data.priceText is string
          && data.maxParticipants is number
          && data.numberOfSessions is number
          && data.numberOfWeeks is number
          && validCourseStatus(data.status)
          && data.slug is string
          && data.publicUrl is string
          && (data.publishedAt == null || data.publishedAt is timestamp)
          && data.coursePlan is list
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function isCourseOwner() {
        return signedIn()
          && resource != null
          && resource.data.ownerUid is string
          && resource.data.ownerUid == myUid();
      }

      function isCourseParentOwner() {
        return signedIn()
          && exists(/databases/$(database)/documents/courses/$(courseId))
          && get(/databases/$(database)/documents/courses/$(courseId)).data.ownerUid is string
          && get(/databases/$(database)/documents/courses/$(courseId)).data.ownerUid == myUid();
      }

      allow read: if accountEnabled() && (isAdmin() || isCourseOwner());

      allow create: if accountEnabled() && (signedIn()
        && validCoursePayload(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);

      allow update: if accountEnabled() && (isCourseOwner()
        && validCoursePayload(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp);

      allow delete: if accountEnabled() && (isCourseOwner());

      match /participants/{participantId} {
        allow read, create, update, delete: if accountEnabled() && (isAdmin() || isCourseParentOwner());
      }

      match /messages/{messageId} {
        allow read, create, update, delete: if accountEnabled() && (isAdmin() || isCourseParentOwner());
      }

      match /signupRequests/{requestId} {
        allow create: if false;
        allow read, update, delete: if accountEnabled() && (isAdmin() || isCourseParentOwner());
      }
    }

    /* =========================
       PLANNERS / 321PLANNER
    ========================= */
    match /planners/{plannerId} {
      // Planner is paused for every ordinary client, including platform administrators.
      allow read, write: if false;
      match /{nested=**} { allow read, write: if false; }
    }

    /* =========================
       SPACES
    ========================= */
    match /spaces/{spaceId} {
  allow read: if accountEnabled() && (signedIn() && (
    isSpaceOwner(spaceId)
    || isSpaceMember(spaceId)
    || isAdmin()));

  allow create: if accountEnabled() && (signedIn()
    && (request.resource.data.ownerId is string)
    && request.resource.data.ownerId == myUid()
    && spaceOwnerUid(request.resource.data) == myUid()
    && (request.resource.data.title is string)
    && request.resource.data.title.size() > 0
    && (request.resource.data.isOpen is bool)
    && requestedSchoolIdOk()
    && (
      isAdmin()
      || (
        isTeacher()
        && (
          !("kind" in request.resource.data)
          || request.resource.data.kind == "class"
        )
      )
      || (
        isParent()
        && ("kind" in request.resource.data)
        && (
          request.resource.data.kind == "family"
          || request.resource.data.kind == "parent_group"
        )
      )
    ));

  allow update: if accountEnabled() && (isAdmin() || isSpaceOwner(spaceId))
    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["schoolId", "ownerId", "ownerUid"]);
  // Deleting only the parent leaves children/members behind and permits recreation
  // with another schoolId. Space removal requires a separate controlled process.
  allow delete: if false;
}

    /* =========================
       PARENT SPACE GOALS
    ========================= */
    match /spaces/{spaceId}/goals/{goalId} {
      allow read: if accountEnabled() && (canTeachInSpace(spaceId) || isSpaceMember(spaceId));

      allow create: if accountEnabled() && ((isAdmin() || isSpaceOwner(spaceId))
        && validParentGoalCreate());

      allow update: if accountEnabled() && ((isAdmin() || isSpaceOwner(spaceId))
        && validParentGoalUpdate());

      allow delete: if accountEnabled() && (isAdmin() || isSpaceOwner(spaceId));
    }

    /* =========================
       SPACE-LOCAL ASSIGNMENTS
    ========================= */
    match /spaces/{spaceId}/lessons/{assignmentId} {
      allow read: if accountEnabled() && (canTeachInSpace(spaceId) || isSpaceMember(spaceId));
      allow create, update: if accountEnabled() && (canTeachInSpace(spaceId));
      allow delete: if accountEnabled() && (isAdmin() || isSpaceOwner(spaceId));
    }


    // F2-06: students write work, never identity or trusted review fields.
    function lessonStudentFields() { return ["sourceType","sourceId","title","level","language","isAnon","status","taskType","lessonType","contentType","mathWorksheet","arithmeticWorksheet","measurementWorksheet","lengthWorksheet","fractionWorksheet","mathType","worksheet","answers","answersByTaskId","auto","startedAt","submittedAt","timeSpentSeconds","readingTestTimeLimitSeconds","readingTestTimeUsedSeconds","readingTestTimeSpentSeconds","readingTestSecondsLeftAtSubmit","readingTestTimedOut","readingTestSubmittedManually","readingTimerResult","audioReading","podcastWorkshop","updatedAt","createdAt","studentArchived","studentArchivedAt","displayName","studentName","studentDisplayName","role","isParentFlow","isChildPortal","childSelfReport"]; }
    function writingStudentFields() { return ["displayName","answersByFieldId","sectionDrafts","finalText","status","printProfile","sectionImprovementRequests","submittedAt","planningSubmittedAt","updatedAt","createdAt"]; }
    function studentCreateIdentityFields() { return ["uid","participantId","studentUid","spaceId","assignmentId","activityId","lessonId","auth"]; }
    function submissionParticipant(spaceId) {
      let member = get(myMemberPath(spaceId)).data;
      return member.get("participantId", "") is string && member.get("participantId", "").size() > 0 ? member.participantId : myUid();
    }
    function submissionScopeOk(data, spaceId, activityId, writing) {
      return data.get("spaceId", spaceId) == spaceId
        && data.get("assignmentId", activityId) == activityId
        && data.get("activityId", activityId) == activityId
        && (writing || data.get("lessonId", activityId) == activityId);
    }
    function studentSubmissionOwned(data, participant) {
      let storedParticipant = data.get("participantId", "");
      return (storedParticipant == participant
        || (storedParticipant == "" && (data.get("uid", "") == myUid()
          || data.get("studentUid", "") in [myUid(), participant])))
        && data.get("studentUid", participant) in [participant, myUid(), data.get("uid", myUid())];
    }
    function submissionIdOk(id, spaceId, activityId, participant, data, existing) {
      let prefix = spaceId + "_" + activityId + "_";
      let storedUid = data.get("uid", "");
      let studentUid = data.get("studentUid", "");
      return id in [prefix + myUid(), prefix + participant]
        || (existing && ((storedUid is string && storedUid.size() > 0 && id in [storedUid, prefix + storedUid])
          || (studentUid is string && studentUid.size() > 0 && id in [studentUid, prefix + studentUid])));
    }
    function studentSubmissionCreate(spaceId, activityId, id, writing) {
      let data = request.resource.data;
      let participant = submissionParticipant(spaceId);
      let editable = writing ? writingStudentFields() : lessonStudentFields();
      return data.keys().hasOnly(editable.concat(studentCreateIdentityFields()))
        && data.get("uid", "") == myUid()
        && data.get("participantId", myUid()) == participant
        && data.get("studentUid", participant) in [myUid(), participant]
        && data.get("spaceId", "") == spaceId
        && (writing ? data.get("activityId", "") == activityId : data.get("assignmentId", "") == activityId)
        && submissionScopeOk(data, spaceId, activityId, writing)
        && submissionIdOk(id, spaceId, activityId, participant, data, false)
        && (!("auth" in data) || (data.auth is map && data.auth.keys().hasOnly(["uid", "participantId", "isAnon"])
          && data.auth.get("uid", "") == myUid() && data.auth.get("participantId", participant) == participant))
        && data.get("status", "draft") in ["draft", "new", "submitted", "planning_submitted"];
    }
    function studentSubmissionUpdate(spaceId, activityId, id, writing) {
      let data = resource.data;
      let participant = submissionParticipant(spaceId);
      return studentSubmissionOwned(data, participant)
        && submissionScopeOk(data, spaceId, activityId, writing)
        && submissionIdOk(id, spaceId, activityId, participant, data, true)
        && request.resource.data.diff(data).affectedKeys().hasOnly(writing ? writingStudentFields() : lessonStudentFields())
        && (request.resource.data.get("status", "draft") == data.get("status", "draft")
          || request.resource.data.get("status", "draft") in ["draft", "new", "submitted", "planning_submitted"]);
    }

    /* =========================
       SPACE-LOCAL WRITING ACTIVITIES
    ========================= */
    match /spaces/{spaceId}/writingActivities/{activityId} {
      allow read: if accountEnabled() && (canTeachInSpace(spaceId) || isSpaceMember(spaceId));
      allow create, update: if accountEnabled() && (canTeachInSpace(spaceId));
      allow delete: if accountEnabled() && (isAdmin() || isSpaceOwner(spaceId));
    }

    match /spaces/{spaceId}/writingActivities/{activityId}/submissions/{subId} {
      function canWritingTeacherRead() {
        return signedIn() && canTeachInSpace(spaceId);
      }

      function isWritingSubOwner() {
        return isSpaceMember(spaceId)
          && resource != null
          && (
            (
              ("studentUid" in resource.data)
              && (resource.data.studentUid is string)
              && (resource.data.studentUid == myUid() || resource.data.studentUid == myWritingParticipantId())
            )
            || (
              ("participantId" in resource.data)
              && (resource.data.participantId is string)
              && resource.data.participantId == myWritingParticipantId()
            )
          );
      }

      function myWritingParticipantId() {
        let member = mySpaceMemberData(spaceId);
        return ("participantId" in member) && (member.participantId is string) && member.participantId.size() > 0
          ? member.participantId
          : myUid();
      }

      function isOwnWritingSubmissionId() {
        return signedIn()
          && (
            subId == (spaceId + "_" + activityId + "_" + myUid())
            || subId == (spaceId + "_" + activityId + "_" + myWritingParticipantId())
          );
      }

      function validStudentWritingIdentity() {
        return (
          (request.resource.data.studentUid is string)
          && (
            request.resource.data.studentUid == myUid()
            || request.resource.data.studentUid == myWritingParticipantId()
          )
          && (
            !("participantId" in request.resource.data)
            || (
              request.resource.data.participantId is string
              && request.resource.data.participantId == myWritingParticipantId()
            )
          )
        );
      }

      function validStudentWritingStatus() {
        return !("status" in request.resource.data)
          || request.resource.data.status == "draft"
          || request.resource.data.status == "planning_submitted"
          || request.resource.data.status == "planning_reviewed"
          || request.resource.data.status == "submitted"
          || request.resource.data.status == "needs_work"
          || request.resource.data.status == "reviewed";
      }

      function writingTeacherFeedbackUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["teacherFeedback", "sectionFeedback"]);
      }

      function writingTeacherReviewUpdateOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "teacherFeedback", "sectionFeedback", "updatedAt"])
          && (
            request.resource.data.status == "reviewed"
            || request.resource.data.status == "needs_work"
            || request.resource.data.status == "planning_reviewed"
          )
          && ("teacherFeedback" in request.resource.data)
          && (request.resource.data.teacherFeedback is map)
          && ("text" in request.resource.data.teacherFeedback)
          && (request.resource.data.teacherFeedback.text is string)
          && (!("sectionFeedback" in request.resource.data) || (request.resource.data.sectionFeedback is map));
      }

      function writingTeacherSectionFeedbackUpdateOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sectionFeedback", "updatedAt"])
          && ("sectionFeedback" in request.resource.data)
          && (request.resource.data.sectionFeedback is map);
      }

      allow read: if accountEnabled() && (canWritingTeacherRead() || isWritingSubOwner());
      allow create: if accountEnabled() && (signedIn() && isSpaceMember(spaceId)
        && studentSubmissionCreate(spaceId, activityId, subId, true));
      allow update: if accountEnabled() && ((signedIn() && isSpaceMember(spaceId)
        && studentSubmissionUpdate(spaceId, activityId, subId, true))
        || (canWritingTeacherRead() && (writingTeacherReviewUpdateOnly() || writingTeacherSectionFeedbackUpdateOnly())));
      allow delete: if accountEnabled() && (isAdmin() || isSpaceOwner(spaceId));
    }

    /* =========================
       SPACE-LOCAL SUBMISSIONS
    ========================= */
    match /spaces/{spaceId}/lessons/{assignmentId}/submissions/{subId} {

  function isSubOwner() {
    return isSpaceMember(spaceId)
      && resource != null
      && ("uid" in resource.data)
      && (resource.data.uid is string)
      && (resource.data.uid == myUid());
  }

  function myParticipantIdHere() {
    let member = mySpaceMemberData(spaceId);
    return ("participantId" in member) && (member.participantId is string) && member.participantId.size() > 0
      ? member.participantId
      : myUid();
  }

  function isParticipantSubOwner() {
    return isSpaceMember(spaceId)
      && resource != null
      && ("participantId" in resource.data)
      && (resource.data.participantId is string)
      && (resource.data.participantId == myParticipantIdHere());
  }

  function isOwnSubmissionId() {
    return isSpaceMember(spaceId)
      && subId == (spaceId + "_" + assignmentId + "_" + myUid());
  }

  function canTeacherReadHere() {
    return signedIn() && canTeachInSpace(spaceId);
  }

  function canParentReadOwnHere() {
    return signedIn()
      && isParent()
      && isSpaceMember(spaceId)
      && isOwnSubmissionId();
  }

  allow read: if
    accountEnabled() && (isSubOwner()
    || isParticipantSubOwner()
    || isOwnSubmissionId()
    || canTeacherReadHere()
    || canParentReadOwnHere());

  allow create: if accountEnabled() && ((signedIn() && isSpaceMember(spaceId)
    && studentSubmissionCreate(spaceId, assignmentId, subId, false))
    || (canTeachInSpace(spaceId) && submissionScopeOk(request.resource.data, spaceId, assignmentId, false)));
  allow update: if accountEnabled() && (canTeachInSpace(spaceId) || (signedIn() && isSpaceMember(spaceId)
    && studentSubmissionUpdate(spaceId, assignmentId, subId, false)));

  allow delete: if false;
}
match /spaces/{spaceId}/lessons/{assignmentId}/parentReviews/{uid} {

  function isOwnParentReview() {
    return signedIn() && uid == myUid();
  }

  allow read: if
    accountEnabled() && (isAdmin()
    || isSpaceOwner(spaceId)
    || (isSpaceMember(spaceId) && isOwnParentReview()));

  allow create, update: if
    accountEnabled() && (signedIn()
    && isParent()
    && isSpaceMember(spaceId)
    && isOwnParentReview());

  allow delete: if false;
}

    /* =========================
       SPACE SUBMISSIONS INDEX
    ========================= */
    match /spaceSubmissions/{id} {

      function isOwnerDoc() {
        return signedIn()
          && spaceIdFromDoc() != null && isSpaceMember(spaceIdFromDoc())
          && resource != null
          && ("uid" in resource.data)
          && (resource.data.uid is string)
          && (resource.data.uid == myUid());
      }

      function myParticipantIdForIndex() {
        let spaceId = spaceIdFromDoc();
        let member = spaceId != null ? mySpaceMemberData(spaceId) : {};
        return ("participantId" in member) && (member.participantId is string) && member.participantId.size() > 0
          ? member.participantId
          : myUid();
      }

      function isParticipantOwnerDoc() {
        return signedIn()
          && spaceIdFromDoc() != null && isSpaceMember(spaceIdFromDoc())
          && resource != null
          && ("participantId" in resource.data)
          && (resource.data.participantId is string)
          && (resource.data.participantId == myParticipantIdForIndex());
      }

      function spaceIdFromDoc() {
        return resource != null && ("spaceId" in resource.data) && (resource.data.spaceId is string)
          ? resource.data.spaceId
          : (request.resource != null
              && (request.resource.data is map)
              && ("spaceId" in request.resource.data)
              && (request.resource.data.spaceId is string))
            ? request.resource.data.spaceId
          : null;
      }

      function canTeacherReadIndex() {
        return signedIn()
          && spaceIdFromDoc() != null
          && canTeachInSpace(spaceIdFromDoc());
      }

      allow read: if accountEnabled() && (isAdmin() || isOwnerDoc() || isParticipantOwnerDoc() || canTeacherReadIndex());


      function indexActivity(data) { return data.get("assignmentId", data.get("activityId", data.get("lessonId", ""))); }
      function indexWriting(data) { return !("assignmentId" in data) && ("activityId" in data); }
      function indexSourceMatches() {
        let data = request.resource.data;
        let space = data.get("spaceId", "");
        let activity = indexActivity(data);
        let writing = indexWriting(data);
        let source = writing
          ? getAfter(/databases/$(database)/documents/spaces/$(space)/writingActivities/$(activity)/submissions/$(id)).data
          : getAfter(/databases/$(database)/documents/spaces/$(space)/lessons/$(activity)/submissions/$(id)).data;
        return activity is string && activity.size() > 0
          && submissionScopeOk(source, space, activity, writing)
          && source.get("uid", "") == data.get("uid", "")
          && source.get("participantId", "") == data.get("participantId", "")
          && source.get("studentUid", "") == data.get("studentUid", "");
      }
      allow create: if accountEnabled() && (signedIn() && indexSourceMatches() && (
        canTeachInSpace(request.resource.data.spaceId)
        || (isSpaceMember(request.resource.data.spaceId)
          && studentSubmissionCreate(request.resource.data.spaceId, indexActivity(request.resource.data), id, indexWriting(request.resource.data)))));
      allow update: if accountEnabled() && (signedIn() && request.resource.data.spaceId == resource.data.spaceId
        && indexSourceMatches() && (canTeacherReadIndex() || (isSpaceMember(resource.data.spaceId)
          && studentSubmissionUpdate(resource.data.spaceId, indexActivity(resource.data), id, indexWriting(resource.data)))));

      allow delete: if false;
    }

    /* =========================
       PRACTICE SUBMISSIONS
    ========================= */
    match /practiceSubmissions/{id} {
      function reviewFields() {
        return [
          "instructorFeedback",
          "reviewStatus",
          "instructorFeedbackUpdatedAt"
        ];
      }

      function isOwnerDoc() {
        return signedIn()
          && resource != null
          && ("uid" in resource.data)
          && (resource.data.uid is string)
          && resource.data.uid == myUid();
      }

      function noReviewFieldsOnCreate() {
        return !request.resource.data.keys().hasAny(reviewFields());
      }

      function reviewFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(reviewFields());
      }

      allow create: if accountEnabled() && (signedIn()
        && (request.resource.data.uid is string)
        && request.resource.data.uid == myUid()
        && noReviewFieldsOnCreate());

      allow read: if accountEnabled() && (isAdmin() || isOwnerDoc());
      allow update: if accountEnabled() && (isAdmin()
        || (isOwnerDoc() && reviewFieldsUnchanged()));
      allow delete: if false;
    }

    /* =========================
       LEGACY SUBMISSIONS
    ========================= */
    match /submissions/{id} {
      function isOwnerDoc() {
        return signedIn()
          && resource != null
          && ("uid" in resource.data)
          && (resource.data.uid is string)
          && (resource.data.uid == myUid());
      }

      allow read: if accountEnabled() && (isAdmin() || (isOwnerDoc()
        && (!("spaceId" in resource.data) || isSpaceMember(resource.data.spaceId))));
      allow create, update, delete: if false;
    }

    // No recursive owner-only submissions grant: it would override Space revocation.
    // Client overviews query the spaceSubmissions index with Space membership checks.

    /* =========================
   ANALYTICS EVENTS
========================= */
match /analyticsEvents/{eventId} {
  // GA-01: stop all client collection; historical authorized reads remain.
  allow create: if false;
  allow read: if accountEnabled() && (isAdmin());
  allow update, delete: if false;
}
   /* =========================
       NOTIFICATIONS
    ========================= */
    match /users/{userId}/notifications/{notificationId} {
      allow read: if accountEnabled() && (request.auth != null
                  && request.auth.uid == userId);

      allow write: if false;
    }

    /* =========================
       Default deny
    ========================= */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
