rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function accountEnabled() {
      let profile = myUser();
      return signedIn() && profile.get("disabled", false) != true
        && profile.get("authDisabled", false) != true
        && (!("authRevokedBefore" in profile) || (profile.authRevokedBefore is number
          && profile.authRevokedBefore >= 0 && request.auth.token.get("auth_time", 0) is number
          && request.auth.token.get("auth_time", 0) > profile.authRevokedBefore));
    }

    function myUid() {
      return request.auth.uid;
    }

    function userPath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function myUserExists() {
      return signedIn() && firestore.exists(userPath(myUid()));
    }

    function myUser() {
      return myUserExists() ? firestore.get(userPath(myUid())).data : {};
    }

    function memberDocId(spaceId, uid) {
      return spaceId + "_" + uid;
    }

    function spacePath(spaceId) {
      return /databases/(default)/documents/spaces/$(spaceId);
    }

    function spaceExists(spaceId) {
      return firestore.exists(spacePath(spaceId));
    }

    function spaceData(spaceId) {
      return spaceExists(spaceId) ? firestore.get(spacePath(spaceId)).data : {};
    }

    // Ownership uses profile + Space + membership: too many cross-service reads.
    // Owner-only access is served by authenticated application routes.
    function isSpaceMember(spaceId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/spaceMembers/$(memberDocId(spaceId, myUid())));
    }

    function spaceMemberData(spaceId) {
      return isSpaceMember(spaceId)
        ? firestore.get(/databases/(default)/documents/spaceMembers/$(memberDocId(spaceId, myUid()))).data
        : {};
    }

    function isActiveSpaceMember(spaceId) {
      let member = spaceMemberData(spaceId);
      return isSpaceMember(spaceId) && isActiveSpaceMemberData(member);
    }

    function isActiveSpaceMemberData(data) {
      let status = data.get("status", "");
      return data is map && data.get("role", "") != "school_admin"
        && status is string && status.lower().matches('[ \\t\\r\\n]*active[ \\t\\r\\n]*')
        && data.get("active", true) == true
        && data.get("archived", false) == false;
    }

    function isSpaceCoTeacher(spaceId) {
      return isActiveSpaceMember(spaceId)
        && (
          (("role" in spaceMemberData(spaceId)) && (spaceMemberData(spaceId).role == "teacher" || spaceMemberData(spaceId).role == "co_teacher"))
          || (("staffRole" in spaceMemberData(spaceId)) && (spaceMemberData(spaceId).staffRole == "co_teacher" || spaceMemberData(spaceId).staffRole == "substitute"))
        );
    }

    function hasRole(roleName) {
      return ("roles" in myUser())
        && (myUser().roles is map)
        && (roleName in myUser().roles)
        && myUser().roles[roleName] == true;
    }

    function myRole() {
      return ("role" in myUser() && (myUser().role is string))
        ? myUser().role
        : "student";
    }

    function isTeacher() {
      return signedIn() && myRole() == "teacher";
    }

    function isAdmin() {
      return signedIn() && (myRole() == "admin" || hasRole("admin"));
    }

    function canReadStudentAudio(spaceId, studentUid) {
      return signedIn()
        && (
          (isActiveSpaceMember(spaceId) && (myUid() == studentUid || myParticipantId(spaceId) == studentUid || isSpaceCoTeacher(spaceId)))
        );
    }

    function canReadIndividualWritingImage(spaceId, pupilId) {
      let member = spaceMemberData(spaceId);
      return signedIn() && (
        (isActiveSpaceMember(spaceId) && (
          myUid() == pupilId || member.get("participantId", "") == pupilId
          || member.get("role", "") in ["teacher", "co_teacher"]
          || member.get("staffRole", "") in ["co_teacher", "substitute"]
        ))
      );
    }

    function myParticipantId(spaceId) {
      return ("participantId" in spaceMemberData(spaceId)) && (spaceMemberData(spaceId).participantId is string) && spaceMemberData(spaceId).participantId.size() > 0
        ? spaceMemberData(spaceId).participantId
        : myUid();
    }

    function assignmentExists(spaceId, assignmentId) {
      return firestore.exists(/databases/(default)/documents/spaces/$(spaceId)/lessons/$(assignmentId));
    }

    function writingActivityExists(spaceId, activityId) {
      return firestore.exists(/databases/(default)/documents/spaces/$(spaceId)/writingActivities/$(activityId));
    }

    function isAudioUpload() {
      return request.resource.contentType.matches('audio/.*')
        || request.resource.contentType == 'application/octet-stream';
    }

    function isIndividualWritingCover() {
      // These legacy files lack a reliable submission binding. Do not expose
      // them through the public teaching-cover namespace while awaiting review.
      // Both uploaded writing-print-* and unlabelled AI writing-* covers were used.
      return resource.name.matches('(.*[/])?covers/[^/]+/writing-.*')
        || resource.metadata.get("context", "") in ["student-writing-print", "student_writing_print"];
    }

    match /spaces/{spaceId}/assignments/{assignmentId}/submissions/{studentUid}/audio/{fileName} {
      // S02 C: legacy files are read through canonical, authenticated server readers.
      // No direct SDK/REST operations; existing data and token metadata are untouched.
      allow read, write: if false;
    }

    match /covers/{ownerUid}/{rest=**} {
      allow read: if !isIndividualWritingCover();
      allow create, update: if accountEnabled() && (signedIn()
        && myUid() == ownerUid
        && myRole() != "student"
        && request.resource.metadata.get("context", "") != "student-writing-print"
        && request.resource.metadata.get("context", "") != "student_writing_print"
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*'));
      allow delete: if accountEnabled() && (signedIn() && (myUid() == ownerUid || isAdmin()));
    }

    match /board-images/{ownerUid}/{spaceId}/{fileName} {
      // S02 C: legacy files are read through canonical, authenticated server readers.
      // No direct SDK/REST operations; existing data and token metadata are untouched.
      allow read, write: if false;
    }

    match /writing-print-images/{ownerUid}/{spaceId}/{activityId}/{fileName} {
      // S02 C: legacy files are read through canonical, authenticated server readers.
      // No direct SDK/REST operations; existing data and token metadata are untouched.
      allow read, write: if false;
    }

    match /live-image-activities/{ownerUid}/{fileName} {
      allow read: if true;
      allow create, update: if accountEnabled() && (signedIn()
        && myUid() == ownerUid
        && (isTeacher() || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*'));
      allow delete: if accountEnabled() && (signedIn() && (myUid() == ownerUid || isAdmin()));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
